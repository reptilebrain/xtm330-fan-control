#!/bin/sh /etc/rc.common

START=95
EXTRA_COMMANDS="status"
EXTRA_HELP="\tstatus\tShow temperatures, fan speed, PWM modes, and channel mappings"

DEVICE=/sys/bus/i2c/devices/0-002d
WAIT_SECONDS=30

log_message() {
	if command -v logger >/dev/null 2>&1; then
		logger -t xtm330-fan "$*" 2>/dev/null || true
	fi
}

fail() {
	echo "xtm330-fan: $*" >&2
	log_message "ERROR: $*"
	return 1
}

write_value() {
	value=$1
	file=$2

	if ! printf '%s\n' "$value" > "$file"; then
		fail "could not write $value to $file"
		return 1
	fi
}

safe_manual() {
	# Do not preflight: attempt every safety write even if another file is missing.
	printf '%s\n' 0 > "$DEVICE/temp5_auto_channels_pwm" 2>/dev/null
	printf '%s\n' 0 > "$DEVICE/temp6_auto_channels_pwm" 2>/dev/null
	printf '%s\n' 252 > "$DEVICE/pwm1" 2>/dev/null
	log_message "configuration failed; attempted manual fallback at PWM 252"
}

check_control_files() {
	for file in \
		"$DEVICE/pwm1" \
		"$DEVICE/temp5_auto_channels_pwm" \
		"$DEVICE/temp6_auto_channels_pwm"
	do
		[ -e "$file" ] || {
			fail "required control file is missing: $file"
			return 1
		}
	done
}

check_configuration_files() {
	check_control_files || return 1

	for file in \
		"$DEVICE/fan1_input" \
		"$DEVICE/temp5_input" \
		"$DEVICE/temp6_input" \
		"$DEVICE/temp5_pwm_enable" \
		"$DEVICE/temp6_pwm_enable"
	do
		[ -e "$file" ] || {
			fail "required configuration file is missing: $file"
			return 1
		}
	done

	for sensor in 5 6; do
		for point in 1 2 3 4 5 6 7; do
			for kind in temp pwm; do
				file="$DEVICE/temp${sensor}_auto_point${point}_${kind}"
				[ -e "$file" ] || {
					fail "required configuration file is missing: $file"
					return 1
				}
			done
		done
	done
}

configure_sensor() {
	sensor=$1
	point=1

	for curve_point in \
		"30000 80" \
		"38000 84" \
		"42000 84" \
		"45000 92" \
		"50000 96" \
		"55000 128" \
		"60000 252"
	do
		set -- $curve_point
		write_value "$1" "$DEVICE/temp${sensor}_auto_point${point}_temp" || return 1
		write_value "$2" "$DEVICE/temp${sensor}_auto_point${point}_pwm" || return 1
		point=$((point + 1))
	done

	# Force the W83793 to re-evaluate the new table on repeated starts.
	write_value 2 "$DEVICE/temp${sensor}_pwm_enable" || return 1
	write_value 3 "$DEVICE/temp${sensor}_pwm_enable"
}

start() {
	waited=0
	while [ ! -e "$DEVICE/pwm1" ] && [ "$waited" -lt "$WAIT_SECONDS" ]; do
		sleep 1
		waited=$((waited + 1))
	done

	[ -e "$DEVICE/pwm1" ] || {
		fail "$DEVICE/pwm1 did not appear within $WAIT_SECONDS seconds"
		return 1
	}

	check_configuration_files || {
		safe_manual
		return 1
	}

	write_value 0 "$DEVICE/temp5_auto_channels_pwm" || {
		safe_manual
		return 1
	}
	write_value 0 "$DEVICE/temp6_auto_channels_pwm" || {
		safe_manual
		return 1
	}
	write_value 84 "$DEVICE/pwm1" || {
		safe_manual
		return 1
	}

	configure_sensor 5 || {
		safe_manual
		return 1
	}
	configure_sensor 6 || {
		safe_manual
		return 1
	}

	write_value 1 "$DEVICE/temp5_auto_channels_pwm" || {
		safe_manual
		return 1
	}
	write_value 1 "$DEVICE/temp6_auto_channels_pwm" || {
		safe_manual
		return 1
	}

	echo "xtm330-fan: SmartFanII configured"
	log_message "SmartFanII configured for temp5/temp6 on PWM1"
}

stop() {
	check_control_files || {
		safe_manual
		return 1
	}

	write_value 0 "$DEVICE/temp5_auto_channels_pwm" || {
		safe_manual
		return 1
	}
	write_value 0 "$DEVICE/temp6_auto_channels_pwm" || {
		safe_manual
		return 1
	}
	write_value 252 "$DEVICE/pwm1" || {
		safe_manual
		return 1
	}

	echo "xtm330-fan: automatic control disabled; PWM1 set to 252"
	log_message "automatic control disabled; PWM1 set to 252"
}

status_value() {
	status_label=$1
	status_file=$2
	status_suffix=$3

	if [ ! -r "$status_file" ]; then
		echo "$status_label: unavailable ($status_file)"
		STATUS_FAILED=1
		return
	fi

	if ! IFS= read -r status_raw < "$status_file"; then
		echo "$status_label: unavailable (could not read $status_file)"
		STATUS_FAILED=1
		return
	fi

	printf '%s: %s%s\n' "$status_label" "$status_raw" "$status_suffix"
}

status_temperature() {
	status_label=$1
	status_file=$2

	if [ ! -r "$status_file" ]; then
		echo "$status_label: unavailable ($status_file)"
		STATUS_FAILED=1
		return
	fi

	if ! IFS= read -r status_raw < "$status_file"; then
		echo "$status_label: unavailable (could not read $status_file)"
		STATUS_FAILED=1
		return
	fi

	status_sign=
	case "$status_raw" in
		-*)
			status_sign=-
			status_raw=${status_raw#-}
			;;
	esac

	case "$status_raw" in
		''|*[!0-9]*)
			echo "$status_label: unavailable (invalid value in $status_file)"
			STATUS_FAILED=1
			return
			;;
	esac

	printf '%s: %s%d.%03d °C\n' \
		"$status_label" "$status_sign" \
		$((status_raw / 1000)) $((status_raw % 1000))
}

status() {
	STATUS_FAILED=0

	status_temperature "temp5" "$DEVICE/temp5_input"
	status_temperature "temp6" "$DEVICE/temp6_input"
	status_value "PWM1" "$DEVICE/pwm1" ""
	status_value "fan1" "$DEVICE/fan1_input" " RPM"
	status_value "temp5 PWM mode" "$DEVICE/temp5_pwm_enable" ""
	status_value "temp6 PWM mode" "$DEVICE/temp6_pwm_enable" ""
	status_value "temp5 channel mapping" "$DEVICE/temp5_auto_channels_pwm" ""
	status_value "temp6 channel mapping" "$DEVICE/temp6_auto_channels_pwm" ""

	return "$STATUS_FAILED"
}
